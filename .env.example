# ---- required in production ----

# postgres connection string. render's free postgres gives you an "internal"
# url, use that one for the web service.
DATABASE_URL=

# used to sign auth tokens, change this to a long random string
JWT_SECRET=

# the exact origin of the deployed frontend, only this one may open a websocket.
# example: https://draftly.onrender.com
FRONTEND_ORIGIN=http://localhost:3000

# comma separated list of proxies we trust for the client ip.
# render sits behind its own proxy, so on render set it to 0.0.0.0/0.
# empty locally (trust nobody).
TRUSTED_PROXIES=


# ---- optional ----

# port the server listens on. render injects this for you, so you normally
# dont set it yourself. falls back to 8080 locally.
PORT=8080
