PORT=8080

# postgres connection string
DATABASE_URL=

# used to sign auth tokens, change this
JWT_SECRET=

# the only origin allowed to open a websocket
FRONTEND_ORIGIN=http://localhost:3000

# comma separated list of proxies we trust for the client ip.
# empty locally (trust nobody). on railway set it to 0.0.0.0/0.
TRUSTED_PROXIES=

# supabase (optional, not read by the backend yet)
SUPABASE_PROJECT_URL=
SUPABASE_API_KEY=
